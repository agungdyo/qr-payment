{
  "realm": "qr-payment",
  "displayName": "QR Payment",
  "enabled": true,
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "sslRequired": "external",
  "defaultRole": {
    "name": "default-roles-qr-payment",
    "description": "${role_default-roles}",
    "composite": true,
    "composites": {
      "realm": ["offline_access"],
      "client": {
        "account": ["view-profile", "manage-account"]
      }
    }
  },
  "roles": {
    "realm": [
      {
        "name": "default-roles-qr-payment",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": ["offline_access"],
          "client": {
            "account": ["view-profile", "manage-account"]
          }
        }
      },
      {
        "name": "admin",
        "description": "Full access",
        "composite": false
      },
      {
        "name": "operator",
        "description": "Limited access",
        "composite": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "qr-payment",
      "name": "QR Payment",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "qr-payment-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/auth/callback"],
      "webOrigins": ["http://localhost:5173", "http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@qr-payment.local",
      "firstName": "Admin",
      "lastName": "Utama",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "admin123", "temporary": false}],
      "realmRoles": ["admin"]
    },
    {
      "username": "operator",
      "enabled": true,
      "email": "operator@qr-payment.local",
      "firstName": "Operator",
      "lastName": "Lapangan",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "operator123", "temporary": false}],
      "realmRoles": ["operator"]
    },
    {
      "username": "customer",
      "enabled": true,
      "email": "customer@qr-payment.local",
      "firstName": "Customer",
      "lastName": "Umum",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "customer123", "temporary": false}],
      "realmRoles": []
    }
  ]
}
