# Template /opt/qr-payment/.env untuk production.
#
#   cp deploy/.env.example /opt/qr-payment/.env
#   vi /opt/qr-payment/.env
#   chmod 600 /opt/qr-payment/.env
#
# Berkas ini dipakai dua hal:
#   1. env_file container `api`  (seluruh isi berkas)
#   2. nilai build-arg `PUBLIC_ORIGIN` untuk image `web` — karena itu skrip deploy
#      membaca berkas ini lebih dulu (`set -a; . /opt/qr-payment/.env; set +a`).
#
# Jangan simpan berkas ini di dalam repo.

# --- Database (PostgreSQL eksternal) ---
# Alamat server database, bukan container: api berjalan di jaringan Docker sendiri.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/qrpayment

# --- Server ---
PORT=3000

# Origin publik backend. Dipakai menyusun redirect URI OIDC, jadi harus persis
# sama dengan URL yang dibuka browser dan terdaftar di Keycloak:
#   <BASE_URL>/auth/callback
BASE_URL=https://qr-payment.example.com
# Origin publik frontend, untuk redirect setelah login.
APP_URL=https://qr-payment.example.com

# Origin publik yang ditanam ke bundle frontend saat build (build-arg compose).
# Isi origin yang sama dengan BASE_URL di atas.
PUBLIC_ORIGIN=https://qr-payment.example.com

# --- Keycloak OIDC ---
OIDC_ISSUER_URL=https://account.maja.id/auth/realms/maja
OIDC_CLIENT_ID=qr-payment
OIDC_CLIENT_SECRET=isi-dari-admin-console-keycloak

# --- Sessions ---
SESSION_COOKIE_NAME=qr-payment.session
# true wajib di production: TLS diterminasi di load balancer, dan browser hanya
# mengirim cookie ini lewat HTTPS.
SESSION_SECURE=true

# --- MAJA H2H (billing gateway) ---
# Selama kredensial kosong, endpoint payment membalas 503 "MAJA belum dikonfigurasi".
MAJA_TOKEN_URL=https://account.maja.id/auth/realms/maja/protocol/openid-connect/token
MAJA_BASE_URL=https://billing.maja.id
MAJA_CLIENT_ID=
MAJA_CLIENT_SECRET=
MAJA_USERNAME=
MAJA_PASSWORD=
MAJA_CUSTOMER_EMAIL=walkin@qr-payment.local

# --- Log ---
RUST_LOG=qr_payment_api=info,tower_http=info,sqlx=warn
