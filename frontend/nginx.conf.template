server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Backend API dan auth Keycloak sama-sama di bawah /api/ (termasuk callback).
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # React Router: alamat halaman (/w/meja-12, /admin/...) tidak pernah jadi berkas,
    # jadi selalu kembalikan index.html dan biarkan router di browser yang memutuskan.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
