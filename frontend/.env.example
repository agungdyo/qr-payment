# Empty/absent → in-browser mock (MAJA register/VA/webhook simulated).
# Set to a real backend (e.g. http://localhost:3000) to hit real endpoints:
#   GET  /api/v1/workspaces/:code
#   GET  /api/v1/workspaces/:code/open-payment
#   POST /api/v1/payments/initiate
#   GET  /api/v1/payments/:id
#   POST /api/v1/payments/:id/inquiry
#   POST /api/v1/payments/:id/cancel
VITE_API_BASE_URL=

# Force the demo control panel even when a real API base is set ("true").
VITE_ENABLE_DEMO=

