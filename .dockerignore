# Konteks build untuk image api (context = root repo).
# target/ berisi 3+ GB hasil build lokal — tanpa baris ini, setiap build mengirim
# seluruhnya ke daemon Docker dan build jadi lambat tanpa alasan.

target
frontend/node_modules
frontend/dist
frontend/.env
frontend/.env.*
frontend/docs

.git
.gitignore
.agents
.freebuff
.learnit
docs

.env
.env.*
!deploy/.env.example
*.log
*.md
!README.md
