[TEMPLATE]
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env to version control.

# --- Database (PostgreSQL) ---
# Port 5434 = mapped from docker-compose (non-conflicting with other services).
DATABASE_URL=postgres://qrpayment:qrpayment@localhost:5434/qrpayment

# --- Server ---
PORT=3000
# Backend origin, dipakai sebagai basis default KEYCLOAK_REDIRECT_URI.
BASE_URL=http://localhost:3000
# Frontend origin, tujuan redirect setelah login.
APP_URL=http://localhost:5173
# Frontend origin yang diizinkan CORS (default: APP_URL).
APP_FRONTEND_URL=http://localhost:5173

# --- Keycloak OIDC ---
# Memakai Keycloak hosted MAJA (account.maja.id), realm `uipod.id`, sama seperti
# uiadv-competition. Client `qr-payment` dibuat di realm itu via Admin Console.
KEYCLOAK_ISSUER_URL=https://account.maja.id/auth/realms/uipod.id
KEYCLOAK_CLIENT_ID=qr-payment
KEYCLOAK_CLIENT_SECRET=change-me
# Harus persis sama dengan Valid Redirect URI di Keycloak.
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Harus terdaftar sebagai Post Logout Redirect URI.
KEYCLOAK_POST_LOGOUT_URI=http://localhost:5173

# --- JWT / Session ---
# Min 32 karakter. Generate: openssl rand -hex 32
JWT_SECRET=change-me
# Menerima 3600, 60s, 15m, 1h, 7d.
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_COOKIE_NAME=qr-payment.session
# Set to true when serving over HTTPS.
SESSION_SECURE=false

# --- MAJA H2H (billing gateway) ---
# Kosongkan kredensial, endpoint payment mengembalikan 503 "MAJA belum dikonfigurasi".
MAJA_TOKEN_URL=https://account.maja.id/auth/realms/maja/protocol/openid-connect/token
# Base URL origin saja, kode menambahkan /api/v2/... sendiri.
MAJA_BASE_URL=https://billing.maja.id
MAJA_CLIENT_ID=
MAJA_CLIENT_SECRET=
MAJA_USERNAME=
MAJA_PASSWORD=
MAJA_CUSTOMER_EMAIL=walkin@qr-payment.local
