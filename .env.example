[TEMPLATE]
# --- Database (PostgreSQL) ---
# Port 5433 = non-conflicting with diary-maja-id stack (5432).
DATABASE_URL=postgres://qrpayment:qrpayment@localhost:5433/qrpayment

# --- Server ---
PORT=3000
# Backend origin (used to build the OIDC redirect URI)
BASE_URL=http://localhost:3000
# Frontend origin (used for post-login redirects)
APP_URL=http://localhost:5173

# --- Keycloak OIDC ---
# Issuer URL of the Keycloak realm (must NOT end with a slash).
# Port 8082 = Keycloak mapped from docker-compose (non-conflicting with 8081).
OIDC_ISSUER_URL=http://localhost:8082/realms/qr-payment
OIDC_CLIENT_ID=qr-payment
OIDC_CLIENT_SECRET=qr-payment-dev-secret

# --- Sessions ---
SESSION_COOKIE_NAME=qr-payment.session
# Set to true when serving over HTTPS
SESSION_SECURE=false

# --- MAJA H2H (billing gateway) ---
# Token + base URL sesuai environment MAJA (billing vs billing-dev).
# Kosongkan kredensial → endpoint payment mengembalikan 503 "MAJA belum dikonfigurasi".
# ===========================================
# MAJA Payment Gateway Credentials
# ===========================================
MAJA_AUTH_URL=https://account.makaramas.com/auth/realms/maja/protocol/openid-connect/token
MAJA_API_URL=https://billing.maja.id/api/v2
MAJA_CLIENT_ID=MAJA80113
MAJA_CLIENT_SECRET=B31tMd8VBkFqTcyKddVqTbPdDP2XmpzD
MAJA_USERNAME=80113
MAJA_PASSWORD=80113
# Email pelanggan default untuk registrasi invoice MAJA (wajib diisi MAJA).
MAJA_CUSTOMER_EMAIL=walkin@qr-payment.local