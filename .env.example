[TEMPLATE]
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env to version control.

# --- Database (PostgreSQL) ---
# Port 5434 = mapped from docker-compose (non-conflicting with other services).
DATABASE_URL=postgres://qrpayment:qrpayment@localhost:5434/qrpayment

# --- Server ---
PORT=3000
# Backend origin (used to build the OIDC redirect URI).
BASE_URL=http://localhost:3000
# Frontend origin (used for post-login redirects).
APP_URL=http://localhost:5173

# --- Keycloak OIDC ---
# Issuer URL of the Keycloak realm (must NOT end with a slash).
# Memakai Keycloak hosted MAJA (account.maja.id), realm `maja` — tanpa Keycloak lokal.
# Client `qr-payment` dibuat di realm `maja` via Admin Console.
OIDC_ISSUER_URL=https://account.maja.id/auth/realms/maja
OIDC_CLIENT_ID=qr-payment
# Isi dengan secret client `qr-payment` dari Admin Console Keycloak (lihat .env).
OIDC_CLIENT_SECRET=change-me

# --- Sessions ---
SESSION_COOKIE_NAME=qr-payment.session
# Set to true when serving over HTTPS.
SESSION_SECURE=false

# --- MAJA H2H (billing gateway) ---
# Kosongkan kredensial → endpoint payment mengembalikan 503 "MAJA belum dikonfigurasi".
# ===========================================
# MAJA Payment Gateway Credentials
# ===========================================
# Token endpoint (OAuth ROPG).
MAJA_TOKEN_URL=https://account.makaramas.com/auth/realms/maja/protocol/openid-connect/token
# Base URL origin saja — kode menambahkan /api/v2/... sendiri.
# Bukan https://billing.maja.id/api/v2 (akan jadi /api/v2/api/v2/...).
MAJA_BASE_URL=https://billing.maja.id
MAJA_CLIENT_ID=MAJA80113
MAJA_CLIENT_SECRET=B31tMd8VBkFqTcyKddVqTbPdDP2XmpzD
MAJA_USERNAME=80113
MAJA_PASSWORD=80113
# Email pelanggan default untuk registrasi invoice MAJA (wajib diisi MAJA).
MAJA_CUSTOMER_EMAIL=walkin@qr-payment.local
